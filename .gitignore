# Personal academic records: never commit
ai-service/data/plans/*.pdf
ai-service/data/transcripts/
*_plan_*.pdf
*_plan_*.json
*transcript*.pdf
*transcript*.json
!ai-service/tests/**/*transcript*.json

# Rebuildable AI-service intermediates. The compact runtime outputs
# (`extracted/skills/*.json`, the career-path ontology, and taxonomy.jsonl)
# are intentionally tracked so a fresh clone and its Docker image behave like
# the tested workspace; large extraction checkpoints and vector caches are not.
ai-service/data/extracted/syllabi/
ai-service/data/extracted/jobs/*
!ai-service/data/extracted/jobs/career_path_skills.json
ai-service/data/taxonomy/cache/
ai-service/data/taxonomy/vector_index.npz
ai-service/data/temp/
ai-service/data/raw/catalog/

# Runtime uploads. Existing tracked fixtures remain until deliberately retired.
backend/uploads/learning-outcomes/*

# Local planning notes
SKILL_EXTRACTION_PLAN.md
ACCOUNTS.txt

# Local graduation-report drafts and generated presentation assets
# Technical Markdown, ADRs, and API contracts under docs/ remain versioned.
CareerCompass_Graduation_Project_Report_*.docx
*.doc
*.docx
*.odt
*.ppt
*.pptx
/docs/figures/
/tools/
