# Logs
*.log

# Personal academic records. Real transcripts carry a student's name, ID
# and full grade history and must never reach the shared repository.
# Course syllabi are not personal and stay tracked: the parser tests use
# them as fixtures.
*_plan_*_EN.pdf
data/extracted/*.json

# Generated taxonomy artifacts. custom_skills.json is a source file and
# stays tracked; these three are rebuilt by run_taxonomy_build, and the
# ESCO crawl cache runs to tens of megabytes.
data/taxonomy/cache/
data/taxonomy/taxonomy.jsonl
data/taxonomy/vector_index.npz

# Scratch output
data/temp/

# Planning notes
SKILL_EXTRACTION_PLAN.md

# Packaging
*.egg-info/
build/
dist/
