# ── CareerCompass Environment Variables ──────────────────────
#
# Copy this file to .env and fill in the real values:
#     cp .env.example .env
#
# .env is gitignored; this template is not. Never put a real
# password or API key in here.

# ── PostgreSQL ───────────────────────────────────────────────
# Used by the LinkedIn scraper and by skills_db for the taxonomy
# and course-skill tables.
CC_DB_HOST=localhost
CC_DB_PORT=5432
CC_DB_NAME=career_compass
CC_DB_USER=your_db_user
CC_DB_PASSWORD=your_db_password

# ── Skill matching backends (all optional) ───────────────────
# The RAG taxonomy stage runs without any of these, on lexical
# retrieval and reranking. Uncomment a line to switch a stage to
# its stronger backend.

# Retrieval. `auto` uses bge-m3 when sentence-transformers is
# installed and falls back to lexical when it is not.
#   auto | lexical | bge
# CC_EMBEDDING_BACKEND=auto
# CC_EMBEDDING_MODEL=BAAI/bge-m3

# Candidate reranking.
#   auto | lexical | cross
# CC_RERANKER=auto
# CC_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Constrained LLM selection for ambiguous candidates. Off by
# default; without it, ambiguous terms go to manual review.
# Requires the anthropic package and a key below.
# CC_MATCH_LLM=1
# CC_MATCH_MODEL=claude-opus-5

# Needed only when CC_MATCH_LLM is on. The SDK also accepts an
# `ant auth login` profile instead of a key.
# ANTHROPIC_API_KEY=sk-ant-...
