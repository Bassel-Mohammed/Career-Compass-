# ── CareerCompass Environment Variables ──────────────────────
#
# Copy this file to .env and fill in the real values:
#     cp .env.example .env
#
# .env is gitignored; this template is not. Never put a real
# password or API key in here.

# ── PostgreSQL ───────────────────────────────────────────────
# Used by the LinkedIn scraper and by skills_db for the taxonomy
# and course-skill tables.
CC_DB_HOST=localhost
CC_DB_PORT=5432
CC_DB_NAME=career_compass
CC_DB_USER=your_db_user
CC_DB_PASSWORD=your_db_password

# ── Skill matching backends ──────────────────────────────────
# The RAG taxonomy stage can run without model downloads, but this
# template selects the locally installed BGE retrieval model and a
# deterministic lexical reranker.

# Retrieval. `auto` uses bge-m3 when sentence-transformers is
# installed and falls back to lexical when it is not.
#   auto | lexical | bge
CC_EMBEDDING_BACKEND=bge
CC_EMBEDDING_MODEL=BAAI/bge-m3
# BGE mini-batch size. Lower this when GPU memory is limited.
CC_EMBEDDING_BATCH_SIZE=8

# Candidate reranking.
#   auto | lexical | cross
CC_RERANKER=lexical
CC_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Constrained LLM selection for ambiguous candidates. The recommended
# setup runs the open-weight Qwen3 model locally through Ollama.
CC_MATCH_LLM=1
CC_MATCH_LLM_PROVIDER=ollama
CC_MATCH_MODEL=qwen3:8b
CC_OLLAMA_URL=http://127.0.0.1:11434
CC_OLLAMA_TIMEOUT=300

# Hosted Anthropic alternative:
# CC_MATCH_LLM_PROVIDER=anthropic
# CC_MATCH_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
